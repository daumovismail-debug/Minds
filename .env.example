# Postgres
POSTGRES_USER=minds
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=minds

# Gemini API key from https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace_with_long_random_string_at_least_32_chars

# Similarity threshold for duplicate detection (0..1, higher = more strict)
DUPLICATE_THRESHOLD=0.85

# External port for the web app (host -> container 3000)
APP_PORT=3001
