# Postgres
DATABASE_URL=postgresql://minds:minds_password@localhost:5432/minds

# Gemini API key from https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# Admin auth (single login for the whole site)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme_strong_password

# Session signing secret (any long random string)
SESSION_SECRET=replace_with_long_random_string_at_least_32_chars

# Similarity threshold for duplicate detection (0..1, higher = more strict)
DUPLICATE_THRESHOLD=0.85
