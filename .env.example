# Postgres
POSTGRES_USER=minds
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=minds

# Groq API key for chat (free, https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API key for embeddings (free trial, https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace_with_long_random_string_at_least_32_chars

# Set true only if you serve over HTTPS
COOKIE_SECURE=false

# Similarity threshold for duplicate detection (0..1, higher = more strict)
DUPLICATE_THRESHOLD=0.85

# External port for the web app (host -> container 3000)
APP_PORT=3001
